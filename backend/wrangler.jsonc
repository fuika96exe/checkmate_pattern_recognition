{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "checkmate-pattern-api",
  "main": ".cloudflare-src/worker.py",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["python_workers"],
  "preview_urls": true,
  "base_dir": ".cloudflare-src",
  "build": {
    "command": "node scripts/prepare-cloudflare-api.mjs"
  },
  "python_modules": {
    "excludes": ["**/*.pyc", "**/__pycache__", "**/tests/**", "**/test_*.py"]
  }
}
