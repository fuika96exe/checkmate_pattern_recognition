{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checkmate-pattern-recognition",
  "account_id": "dd41322a466483ab934ab493f2df7a0d",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "API",
      "service": "checkmate-pattern-api"
    }
  ]
}
